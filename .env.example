# Base URL of the fixmate-server backend (Better Auth is mounted at /api/auth there).
# Public, non-secret value. In production builds this MUST be set to the public
# HTTPS URL of the backend; a missing or non-HTTPS value fails the build.
# Only local development (`next dev`) falls back to http://localhost:5000.
NEXT_PUBLIC_API_URL=http://localhost:5000
